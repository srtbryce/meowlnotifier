
if not meowlnotifier then
	game:GetService("Players").LocalPlayer:Kick("No script key was provided for Meowl Notifier, please check your script again or contact staff at discord.gg/meowlnotifier for assistance.")
	return
end

print("[Meowl Notifier] Script key provided is: " .. meowlnotifier)
print("[Meowl Notifier] Checking if key: " .. meowlnotifier .. " is valid")

local base_url = "https://isdeqrdiuxldpyyjvkqr.supabase.co/functions/v1/verify-script-key"

local http_request = http_request or (syn and syn.request) or request

local httpservice = game:GetService("HttpService")

local cached_session = nil

local function verifykey(player, retries)
	if cached_session then
		return cached_session
	end

	retries = retries or 1

	if not http_request then
		game:GetService("Players").LocalPlayer:Kick("ur executor is so ahh -- luckey")
		return nil
	end

	for attempt = 1, retries do
		local success, response = pcall(function()
			return http_request({
				Url = base_url .. "?key=" .. meowlnotifier,
				Method = "GET",
				Headers = {
					["Content-Type"] = "application/json"
				}
			})
		end)

		if success and response and response.Body then
			local ok, data = pcall(function()
				return httpservice:JSONDecode(response.Body)
			end)

			if ok and data then
				if data.valid then
					print("[Meowl Notifier] User is authenticated (Discord " .. tostring(data.discord_id) .. ", slot #" .. tostring(data.slot_number) .. ")")
					cached_session = data
					return cached_session
				else
					local reason = tostring(data.error or "unknown")
					if reason == "No active slot" then
						game:GetService("Players").LocalPlayer:Kick("You currently don't have a slot for Meowl Notifier, please purchase a slot at https://meowlnotifier.com and try again.")
					elseif reason == "User blacklisted" then
						game:GetService("Players").LocalPlayer:Kick("You are currently blacklisted from Meowl Notifier.")
					elseif reason == "Unknown key" then
						game:GetService("Players").LocalPlayer:Kick("Your Meowl Notifier key is invalid. Find it or regenerate it at https://meowlnotifier.com/.")
					else
						game:GetService("Players").LocalPlayer:Kick("Something went wrong while trying to authenticate Meowl Notifier!")
					end
					return nil
				end
			end
		end

		task.wait(1.5 * attempt)
	end

	game:GetService("Players").LocalPlayer:Kick("Failed to connect to Meowl Notifier authentication server after retries.")
	return nil
end

local function safe_verifykey(player, max_retries)
	max_retries = max_retries or 3
	for i = 1, max_retries do
		local result = verifykey(player, 1)
		if result then
			return result
		end
		task.wait(2)
	end
	game:GetService("Players").LocalPlayer:Kick("Could not verify Meowl Notifier after multiple attempts.")
	return nil
end

local session = safe_verifykey(game:GetService("Players").LocalPlayer, 3)
if not session then return end

getgenv().MEOWL_SESSION = {
	discord_id   = session.discord_id,
	display_name = session.display_name,
	slot_number  = session.slot_number,
	delay        = session.delay,
	expires_at   = session.expires_at,
}

